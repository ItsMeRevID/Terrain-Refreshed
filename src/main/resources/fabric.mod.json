{
	"schemaVersion": 1,
	"id": "terrainrefreshed",
	"version": "${version}",
	"name": "Terrain Refreshed",
	"description": "Terrain Refreshed overhauls Minecraft's world generation: realistic terrain shaping, dramatic mountains, flowing streams and rivers, 100 new biomes with hand-tuned colors, natural vegetation, and organically grown fancy trees.",
	"authors": [
		"RevSkyMC"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/terrain-refreshed",
		"sources": "https://github.com/RevSkyMC/Terrain-Refreshed"
	},
	"license": "MIT",
	"icon": "assets/terrainrefreshed/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.revskymc.terrainrefreshed.TerrainRefreshed"
		],
		"client": [
			"net.revskymc.terrainrefreshed.client.TerrainRefreshedClient"
		]
	},
	"mixins": [
		"terrainrefreshed.mixins.json",
		{
			"config": "terrainrefreshed.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"minecraft_version": "1.21 - 26.3",
		"author": "RevSkyMC",
		"package": "net.revskymc.terrainrefreshed"
	}
}
